# Salin file ini jadi ".env" lalu isi nilai-nilai di bawah dengan punyamu sendiri.
# JANGAN pernah commit file ".env" (isinya rahasia) -- yang boleh di-commit cuma
# ".env.example" ini (isinya cuma contoh/placeholder, bukan key beneran).

# API key Gemini gratis, bikin di https://aistudio.google.com/apikey
# Boleh isi 1 saja (GEMINI_API_KEY_1) atau lebih (GEMINI_API_KEY_2, _3, dst)
# supaya bot otomatis gantian key kalau salah satu kena limit gratis.
GEMINI_API_KEY_1=isi_api_key_gemini_kamu_di_sini
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=

# API key DeepSeek (buat fitur .deepai) -- bikin/beli di https://platform.deepseek.com/api_keys
# BEDA dari Gemini: DeepSeek gak ada tier gratis permanen, saldo dipotong per pemakaian.
# Boleh isi 1 saja (DEEPSEEK_API_KEY_1) atau lebih (_2, _3, dst) kalau punya lebih dari 1 akun,
# biar bot otomatis gantian key kalau salah satu lagi kena limit/habis saldo.
DEEPSEEK_API_KEY_1=isi_api_key_deepseek_kamu_di_sini
DEEPSEEK_API_KEY_2=
DEEPSEEK_API_KEY_3=

# API key Groq (buat fitur .groqai) -- GRATIS, bikin di https://console.groq.com/keys
# (gak perlu kartu kredit). Yang dibatasi cuma jumlah request per menit/hari, bukan saldo --
# mirip Gemini. Boleh isi lebih dari 1 (dari akun berbeda) biar bot gantian kalau kena limit.
GROQ_API_KEY_1=isi_api_key_groq_kamu_di_sini
GROQ_API_KEY_2=
GROQ_API_KEY_3=

# API key Mistral (buat fitur .mistralai) -- ada tier gratis "Experiment" di La Plateforme,
# bikin di https://console.mistral.ai/api-keys (gak perlu kartu kredit). Rate-limited, buat
# eksperimen/prototyping -- bukan buat trafik produksi berat.
MISTRAL_API_KEY_1=isi_api_key_mistral_kamu_di_sini
MISTRAL_API_KEY_2=
MISTRAL_API_KEY_3=

# API key NaraRouter (buat fitur .imajin -- generate gambar dari teks) -- bikin di
# https://router.bynara.id/keys (atau https://router.naraya.ai/keys, dua domain resmi yang
# sama). PENTING: generate gambar DIBILLING PER GAMBAR (bukan bagian dari token gratis harian
# NaraRouter), walau model default yang dipakai bot ini murah banget (~Rp10/gambar). Tetap
# perlu isi saldo di akun NaraRouter kamu.
NARA_API_KEY_1=isi_api_key_nara_kamu_di_sini
NARA_API_KEY_2=
NARA_API_KEY_3=

# Bot Token Telegram gratis (buat fitur .telesticker) -- chat @BotFather di Telegram,
# ketik /newbot, ikutin instruksinya, copy token yang dikasih ke sini. Opsional, kalau
# gak diisi cuma .telesticker aja yang gak bisa dipakai, fitur lain tetap normal.
TELEGRAM_BOT_TOKEN=

# Nomor WhatsApp owner (format internasional tanpa "+", contoh: 628123456789)
OWNER_NUMBER=

# LID owner (opsional, isi kalau fitur owner-only nolak nomor kamu sendiri --
# lihat komentar ownerLid di config.js buat cara ambilnya)
OWNER_LID=
